rules_version='2';
service firebase.storage{match /b/{b}/o{
 function admin(){return request.auth!=null&&request.auth.token.admin==true;}
 match /public/{f=**}{allow read:if true;allow write:if admin()&&request.resource.size<15*1024*1024&&request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');allow delete:if admin();}
 match /{o=**}{allow read,write:if false;}}}
